<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- MactteryGuard 특권 헬퍼 데몬 (SMAppService 등록용).
	     앱 번들 Contents/Library/LaunchDaemons/ 안에 헬퍼 바이너리와 함께 내장된다.
	     StandardOutPath/StandardErrorPath는 의도적으로 없음 — launchd가 데몬보다
	     먼저 로그 파일을 열기 때문에 데몬이 로그 디렉토리를 만들 기회를 잃는다.
	     데몬은 자체 로그(/Library/Logs/MactteryGuard/)를 직접 관리한다. -->
	<key>Label</key>
	<string>com.loveaimg.mactteryguard.helper</string>
	<!-- BundleProgram은 앱 번들 루트 기준 상대 경로 (launchd.plist(5) man page:
	     "an app-bundle relative path"). 파일명만 적으면 <App>.app/MactteryGuardHelper를
	     찾으므로 데몬이 실행되지 않는다. -->
	<key>BundleProgram</key>
	<string>Contents/Library/LaunchDaemons/MactteryGuardHelper</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>MachServices</key>
	<dict>
		<key>com.loveaimg.mactteryguard.helper</key>
		<dict>
			<key>ResetAtClose</key>
			<true/>
		</dict>
	</dict>
</dict>
</plist>
